{
  "name": "reciclapac",
  "private": true,
  "scripts": {
    "test": "npm run test:unit && npm run test:firestore-rules",
    "emulators:local": "firebase emulators:start --project demo-reciclapac --only firestore,auth",
    "serve:local": "node scripts/serve-local.js",
    "seed:local": "node scripts/seed-demo-emulator.js",
    "test:unit": "node --test tests/site-structure.test.js tests/ranking-logic.test.js tests/google-drive-worker-integration.test.js tests/registro-express.test.js",
    "test:firestore-rules": "firebase emulators:exec --project demo-reciclapac --only firestore \"node --test tests/firestore-rules.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.3",
    "firebase": "^10.14.1",
    "firebase-tools": "^15.34.0"
  }
}
