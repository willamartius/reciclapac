rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/reciclar-apac-roles/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/reciclar-apac-roles/$(request.auth.uid))
        && userRole() == 'admin';
    }

    function isOperator() {
      return signedIn()
        && exists(/databases/$(database)/documents/reciclar-apac-roles/$(request.auth.uid))
        && userRole() == 'operator';
    }

    function canUseApp() {
      return isAdmin() || isOperator();
    }

    function isValidOperatorMetaSnapshot(recordId) {
      let data = request.resource.data;
      let campaignPath = /databases/$(database)/documents/reciclar-apac/campanhas/records/$(data.campanhaId);
      return isOperator()
        && data.keys().hasOnly(['id', 'campanhaId', 'chave', 'metas'])
        && data.id == recordId
        && data.chave.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && exists(campaignPath)
        && data.metas == get(campaignPath).data.metasDefault;
    }

    function isValidPublicTransferRequest(requestId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'id', 'campanhaId', 'campanhaNome',
          'colaboradorOrigemId', 'colaboradorOrigemNome', 'categoriaOrigem',
          'materialOrigemNome', 'quantidadeOrigem',
          'colaboradorDestinoId', 'colaboradorDestinoNome', 'categoriaDestino',
          'materialDestinoNome', 'quantidadeDestino', 'solicitadoEm', 'status', 'senha'
        ])
        && data.keys().hasAll([
          'id', 'campanhaId', 'campanhaNome',
          'colaboradorOrigemId', 'colaboradorOrigemNome', 'categoriaOrigem',
          'materialOrigemNome', 'quantidadeOrigem',
          'colaboradorDestinoId', 'colaboradorDestinoNome', 'categoriaDestino',
          'materialDestinoNome', 'quantidadeDestino', 'solicitadoEm', 'status', 'senha'
        ])
        && data.id == requestId
        && data.campanhaId is string && data.campanhaId.size() > 0 && data.campanhaId.size() <= 200
        && data.campanhaNome is string && data.campanhaNome.size() > 0 && data.campanhaNome.size() <= 200
        && data.colaboradorOrigemId is string && data.colaboradorOrigemId.size() > 0 && data.colaboradorOrigemId.size() <= 200
        && data.colaboradorOrigemNome is string && data.colaboradorOrigemNome.size() > 0 && data.colaboradorOrigemNome.size() <= 120
        && data.categoriaOrigem is string && data.categoriaOrigem.size() > 0 && data.categoriaOrigem.size() <= 120
        && data.materialOrigemNome is string && data.materialOrigemNome.size() > 0 && data.materialOrigemNome.size() <= 120
        && data.quantidadeOrigem is int && data.quantidadeOrigem > 0 && data.quantidadeOrigem <= 9007199254740991
        && data.colaboradorDestinoId is string && data.colaboradorDestinoId.size() > 0 && data.colaboradorDestinoId.size() <= 200
        && data.colaboradorDestinoNome is string && data.colaboradorDestinoNome.size() > 0 && data.colaboradorDestinoNome.size() <= 120
        && data.categoriaDestino is string && data.categoriaDestino.size() > 0 && data.categoriaDestino.size() <= 120
        && data.materialDestinoNome is string && data.materialDestinoNome.size() > 0 && data.materialDestinoNome.size() <= 120
        && data.quantidadeDestino is int && data.quantidadeDestino > 0 && data.quantidadeDestino <= 9007199254740991
        && data.colaboradorOrigemId != data.colaboradorDestinoId
        && data.categoriaOrigem != data.categoriaDestino
        && data.solicitadoEm is timestamp && data.solicitadoEm == request.time
        && data.status == 'pendente'
        && data.senha is string && data.senha.size() <= 200
        && senhaSolicitacaoTrocaValida(data.senha);
    }

    function senhaSolicitacaoTrocaConfigurada() {
      let path = /databases/$(database)/documents/reciclar-apac-public-settings/trocaSenha;
      return exists(path) && get(path).data.senha is string && get(path).data.senha.size() > 0;
    }

    function senhaSolicitacaoTrocaValida(senhaEnviada) {
      let path = /databases/$(database)/documents/reciclar-apac-public-settings/trocaSenha;
      return !senhaSolicitacaoTrocaConfigurada() || get(path).data.senha == senhaEnviada;
    }

    function isApprovedTransferPair(requestId) {
      let data = request.resource.data;
      let transferIds = data.transferenciaIds;
      let firstPath = /databases/$(database)/documents/reciclar-apac/transferencias/records/$(transferIds[0]);
      let secondPath = /databases/$(database)/documents/reciclar-apac/transferencias/records/$(transferIds[1]);
      let first = getAfter(firstPath).data;
      let second = getAfter(secondPath).data;
      return transferIds is list
        && transferIds.size() == 2
        && existsAfter(firstPath)
        && existsAfter(secondPath)
        && first.id == transferIds[0]
        && second.id == transferIds[1]
        && first.campanhaId == resource.data.campanhaId
        && second.campanhaId == resource.data.campanhaId
        && first.colaboradorOrigemId == resource.data.colaboradorOrigemId
        && first.categoriaOrigem == resource.data.categoriaOrigem
        && first.quantidade == resource.data.quantidadeOrigem
        && first.colaboradorDestinoId == resource.data.colaboradorDestinoId
        && first.categoriaDestino == resource.data.categoriaDestino
        && second.colaboradorOrigemId == resource.data.colaboradorDestinoId
        && second.categoriaOrigem == resource.data.categoriaDestino
        && second.quantidade == resource.data.quantidadeDestino
        && second.colaboradorDestinoId == resource.data.colaboradorOrigemId
        && second.categoriaDestino == resource.data.categoriaOrigem
        && first.data == second.data
        && first.motivo == 'Troca aprovada a partir da solicitação pública ' + requestId
        && second.motivo == first.motivo;
    }

    match /reciclar-apac-roles/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /reciclar-apac-migrations/{collectionId} {
      allow read: if canUseApp();
      allow write: if isAdmin();
    }

    match /reciclar-apac-public-settings/{settingId} {
      allow read: if settingId == 'maintenance'
        || (settingId == 'trocaSenha' && isAdmin());
      allow create, update: if settingId == 'maintenance'
        ? (isAdmin()
          && request.resource.data.keys().hasOnly(['ativada', 'atualizadoEm'])
          && request.resource.data.keys().hasAll(['ativada', 'atualizadoEm'])
          && request.resource.data.ativada is bool
          && request.resource.data.atualizadoEm is string)
        : settingId == 'trocaSenha'
          && isAdmin()
          && request.resource.data.keys().hasOnly(['senha', 'atualizadoEm'])
          && request.resource.data.keys().hasAll(['senha', 'atualizadoEm'])
          && request.resource.data.senha is string
          && request.resource.data.senha.size() <= 200
          && request.resource.data.atualizadoEm is string;
      allow delete: if (settingId == 'maintenance' || settingId == 'trocaSenha') && isAdmin();
    }

    match /reciclar-apac-drive-links/{userId} {
      allow get: if isAdmin() && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if isAdmin()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['googleSub', 'email', 'linkedAt'])
        && request.resource.data.keys().hasAll(['googleSub', 'email', 'linkedAt'])
        && request.resource.data.googleSub is string
        && request.resource.data.email is string
        && request.resource.data.linkedAt is string;
      allow delete: if isAdmin() && request.auth.uid == userId;
    }

    match /reciclar-apac-public-ranking/{rankingId} {
      allow read: if true;
      allow create, update: if canUseApp()
        && request.resource.data.keys().hasOnly([
          'campanhaId', 'campanhaNome', 'mes', 'ano', 'atualizadoEm', 'temDados',
          'participantes', 'materiais', 'solicitacoesPermitidas', 'ranking'
        ])
        && request.resource.data.keys().hasAll([
          'campanhaId', 'campanhaNome', 'mes', 'ano', 'atualizadoEm', 'temDados', 'ranking'
        ])
        && request.resource.data.campanhaId is string
        && request.resource.data.campanhaNome is string
        && request.resource.data.mes is int
        && request.resource.data.mes >= 1
        && request.resource.data.mes <= 12
        && request.resource.data.ano is int
        && request.resource.data.ano >= 2000
        && request.resource.data.ano <= 9999
        && request.resource.data.atualizadoEm is string
        && request.resource.data.temDados is bool
        && (!('participantes' in request.resource.data) || request.resource.data.participantes is list)
        && (!('materiais' in request.resource.data) || request.resource.data.materiais is list)
        && (!('solicitacoesPermitidas' in request.resource.data) || request.resource.data.solicitacoesPermitidas is bool)
        && request.resource.data.ranking is list;
      allow delete: if isAdmin();
    }

    match /reciclar-apac-transfer-requests/{requestId} {
      allow get, list: if isAdmin();
      allow create: if request.auth == null && isValidPublicTransferRequest(requestId);
      allow update: if isAdmin()
        && resource.data.status == 'pendente'
        && request.resource.data.id == resource.data.id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'decididoEm', 'decididoPor', 'transferenciaIds'
        ])
        && request.resource.data.keys().hasAll([
          'decididoEm', 'decididoPor', 'transferenciaIds'
        ])
        && request.resource.data.status in ['aprovada', 'rejeitada']
        && request.resource.data.decididoEm is string
        && request.resource.data.decididoPor == request.auth.uid
        && request.resource.data.transferenciaIds is list
        && (request.resource.data.status == 'rejeitada'
          ? request.resource.data.transferenciaIds.size() == 0
          : isApprovedTransferPair(requestId));
      allow delete: if false;
    }

    match /reciclar-apac/{key} {
      allow read: if canUseApp();
      allow write: if isAdmin();

      match /records/{recordId} {
        allow read: if key == 'lixeira' ? isAdmin() : canUseApp();
        allow create, update: if isAdmin()
          || (isOperator()
            && key in ['colaboradores', 'entregas', 'transferencias']
            && request.resource.data.id == recordId);
        allow delete: if isAdmin();
      }
    }


    match /reciclapac-fichas/{recordId} {
      allow read: if canUseApp();
      allow create: if isAdmin()
        && recordId.matches('^[0-9]{6}
      allow read: if canUseApp();
      allow create: if isAdmin() || isValidOperatorMetaSnapshot(recordId);
      allow update, delete: if isAdmin();
    }
  }
}
)
        && request.resource.data.keys().hasOnly([
          'id', 'status', 'colaboradorId', 'colaboradorNome', 'campanhaId',
          'loteId', 'emitidaPor', 'emitidaEm'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'status', 'colaboradorId', 'colaboradorNome', 'campanhaId',
          'loteId', 'emitidaPor', 'emitidaEm'
        ])
        && request.resource.data.id == recordId
        && request.resource.data.status == 'emitida'
        && request.resource.data.colaboradorId is string
        && request.resource.data.colaboradorNome is string
        && request.resource.data.campanhaId is string
        && request.resource.data.loteId is string
        && request.resource.data.emitidaPor == request.auth.uid
        && request.resource.data.emitidaEm == request.time;
      allow update: if canUseApp()
        && resource.data.status == 'emitida'
        && request.resource.data.id == resource.data.id
        && request.resource.data.colaboradorId == resource.data.colaboradorId
        && request.resource.data.colaboradorNome == resource.data.colaboradorNome
        && request.resource.data.campanhaId == resource.data.campanhaId
        && request.resource.data.loteId == resource.data.loteId
        && request.resource.data.emitidaPor == resource.data.emitidaPor
        && request.resource.data.emitidaEm == resource.data.emitidaEm
        && (
          (isAdmin()
            && request.resource.data.status == 'cancelada'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'canceladaEm', 'canceladaPor'])
            && request.resource.data.canceladaEm == request.time
            && request.resource.data.canceladaPor == request.auth.uid)
          ||
          (request.resource.data.status == 'utilizada'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'utilizadaEm', 'utilizadaPor', 'entregaId', 'quantidades', 'total', 'data'
            ])
            && request.resource.data.utilizadaEm == request.time
            && request.resource.data.utilizadaPor == request.auth.uid
            && request.resource.data.entregaId is string
            && request.resource.data.quantidades is list
            && request.resource.data.quantidades.size() == 6
            && request.resource.data.quantidades[0] is int
            && request.resource.data.quantidades[0] >= 0
            && request.resource.data.quantidades[0] <= 999
            && request.resource.data.quantidades[1] is int
            && request.resource.data.quantidades[1] >= 0
            && request.resource.data.quantidades[1] <= 999
            && request.resource.data.quantidades[2] is int
            && request.resource.data.quantidades[2] >= 0
            && request.resource.data.quantidades[2] <= 999
            && request.resource.data.quantidades[3] is int
            && request.resource.data.quantidades[3] >= 0
            && request.resource.data.quantidades[3] <= 999
            && request.resource.data.quantidades[4] is int
            && request.resource.data.quantidades[4] >= 0
            && request.resource.data.quantidades[4] <= 999
            && request.resource.data.quantidades[5] is int
            && request.resource.data.quantidades[5] >= 0
            && request.resource.data.quantidades[5] <= 999
            && request.resource.data.total is int
            && request.resource.data.total >= 0
            && request.resource.data.total <= 5994
            && request.resource.data.data is string)
        );
      allow delete: if false;
    }

    match /reciclar-apac/metas/records/{recordId} {
      allow read: if canUseApp();
      allow create: if isAdmin() || isValidOperatorMetaSnapshot(recordId);
      allow update, delete: if isAdmin();
    }
  }
}
